{
  "description": "LTLf deny hook: blocks a pending call when a deny spec in the project's .claude/ltlf/ forbids it.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python -I -S \"${CLAUDE_PLUGIN_ROOT}/hooks/deny.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
